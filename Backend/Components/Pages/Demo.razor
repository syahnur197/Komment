@page "/demo"
@rendermode InteractiveServer
@attribute [Authorize]
@inject SiteService _siteService
@inject NavigationManager Nav

<PageTitle>Demo</PageTitle>

<h1 class="text-2xl font-semibold text-slate-900">Demo</h1>
<p class="mt-1 text-sm text-slate-500">
    The reader-facing widget, running against a real site of yours in a plain HTML page.
</p>

@if (sites is null)
{
    <p class="mt-4 text-slate-500">Loading…</p>
}
else if (sites.Count == 0)
{
    <div class="mt-6 rounded-lg border border-dashed border-slate-300 bg-white p-8 text-center">
        <p class="text-slate-600">Add a site first.</p>
        <p class="mt-1 text-sm text-slate-500">The widget is scoped to one site, so there is nothing to demo yet.</p>
        <a href="sites/new" class="mt-4 inline-block rounded bg-sky-700 px-4 py-2 text-sm font-medium text-white no-underline hover:bg-sky-800">
            Add site
        </a>
    </div>
}
else
{
    <div class="mt-6 flex flex-wrap items-end gap-4">
        <label class="text-sm">
            <span class="mb-1 block font-medium text-slate-700">Site</span>
            <select @bind="slug" @bind:after="Remount"
                    class="rounded border border-slate-300 bg-white px-3 py-2 text-sm">
                @foreach (var site in sites)
                {
                    <option value="@site.Slug">@site.Name (@site.Slug)</option>
                }
            </select>
        </label>

        <a href="@src" target="_blank" rel="noopener"
           class="rounded border border-slate-300 bg-white px-4 py-2 text-sm font-medium text-slate-700 no-underline hover:bg-slate-50">
            Open in a new tab
        </a>
    </div>

    <p class="mt-6 text-sm font-medium text-slate-700">Drop this on the blog:</p>
    <pre class="mt-2 overflow-x-auto rounded-lg bg-slate-900 p-4 text-xs text-slate-100"><code>&lt;div id="komment"&gt;&lt;/div&gt;
&lt;script src="@(Nav.BaseUri)embed.js" data-site="@slug"&gt;&lt;/script&gt;</code></pre>
    <p class="mt-2 text-xs text-slate-500">
        The post key defaults to the page's own path; set <code>data-slug</code> to override it.
    </p>

    @* The iframe is the point: the widget renders in a document this app does not
       style, so what you see here is what a blog gets. Rendering it inline would
       let the console's Tailwind reset dress it up. *@
    <iframe src="@src" title="Comment widget preview" @key="src"
            class="mt-6 h-[40rem] w-full rounded-lg border border-slate-200 bg-white"></iframe>

    <p class="mt-3 text-xs text-slate-500">
        Signing in from here lands back on <strong>@(sites.First(s => s.Slug == slug).Origins.FirstOrDefault() ?? "the site's first origin")</strong>,
        not this page — the OAuth callback only returns to an origin registered on the site.
        Add <code>@Nav.BaseUri.TrimEnd('/')</code> to this site's origins to finish the round trip here.
    </p>
}

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private List<SiteResponse>? sites;
    private string slug = "";
    private string src = "";

    protected override async Task OnInitializedAsync()
    {
        var ownerId = UserClaims.UserIdOf((await AuthState).User)!.Value;

        sites = await _siteService.ListAsync(ownerId, default);
        slug = sites.FirstOrDefault()?.Slug ?? "";

        Remount();
    }

    // Changing the src is what reloads the iframe; @key forces a fresh element so
    // the preview never keeps the previous site's thread on screen.
    private void Remount() => src = $"demo.html?site={Uri.EscapeDataString(slug)}";
}
