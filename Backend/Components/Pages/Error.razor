@page "/Error"
@using System.Diagnostics

<PageTitle>Error</PageTitle>

<h1 class="text-2xl font-semibold text-slate-900">Something went wrong</h1>
<p class="mt-2 text-slate-600">An error occurred while processing your request.</p>

@if (ShowRequestId)
{
    <p class="mt-4 text-sm text-slate-500">
        Request ID: <code class="rounded bg-slate-200 px-1.5 py-0.5 font-mono text-slate-700">@RequestId</code>
    </p>
}

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
