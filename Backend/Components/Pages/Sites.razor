@page "/sites"
@rendermode InteractiveServer
@attribute [Authorize]
@inject SiteService _siteService

<PageTitle>Sites</PageTitle>

<div class="flex items-center justify-between">
    <h1 class="text-2xl font-semibold text-slate-900">Sites</h1>
    <a href="sites/new" class="rounded bg-sky-700 px-4 py-2 text-sm font-medium text-white no-underline hover:bg-sky-800">
        Add site
    </a>
</div>

@if (error is not null)
{
    <p class="mt-4 rounded bg-red-50 px-3 py-2 text-sm text-red-700" role="alert">@error</p>
}

@if (sites is null)
{
    <p class="mt-4 text-slate-500">Loading…</p>
}
else if (sites.Count == 0)
{
    <div class="mt-6 rounded-lg border border-dashed border-slate-300 bg-white p-8 text-center">
        <p class="text-slate-600">No sites yet.</p>
        <p class="mt-1 text-sm text-slate-500">A site is one blog. Registering it also allows its origin through CORS.</p>
    </div>
}
else
{
    <div class="mt-6 overflow-x-auto rounded-lg border border-slate-200 bg-white">
        <table class="w-full text-left text-sm">
            <thead class="border-b border-slate-200 text-slate-500">
                <tr>
                    <th class="px-4 py-3 font-medium">Name</th>
                    <th class="px-4 py-3 font-medium">Slug</th>
                    <th class="px-4 py-3 font-medium">Origins</th>
                    <th class="px-4 py-3"><span class="sr-only">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var site in sites)
                {
                    <tr class="border-b border-slate-100 last:border-0">
                        <td class="px-4 py-3 text-slate-900">@site.Name</td>
                        <td class="px-4 py-3"><code class="rounded bg-slate-100 px-1.5 py-0.5 font-mono text-slate-700">@site.Slug</code></td>
                        <td class="px-4 py-3 text-slate-600">
                            @foreach (var origin in site.Origins)
                            {
                                <div>@origin</div>
                            }
                        </td>
                        <td class="px-4 py-3 text-right whitespace-nowrap">
                            @* Two-step rather than a JS confirm(): interactivity makes
                               the safer version the simpler one, and keeps the project
                               free of interop for a dialog. *@
                            @if (pendingDelete == site.SiteId)
                            {
                                <span class="text-slate-600">Delete @site.Name and every comment on it?</span>
                                <button type="button" @onclick="() => DeleteAsync(site.SiteId)"
                                        class="ml-3 font-medium text-red-600 hover:underline">Delete</button>
                                <button type="button" @onclick="() => pendingDelete = null"
                                        class="ml-3 text-slate-500 hover:underline">Cancel</button>
                            }
                            else
                            {
                                <a href="sites/@site.SiteId/comments" class="text-sky-700 no-underline hover:underline">Comments</a>
                                <a href="sites/@site.SiteId" class="ml-3 text-sky-700 no-underline hover:underline">Edit</a>
                                <button type="button" @onclick="() => pendingDelete = site.SiteId"
                                        class="ml-3 text-red-600 hover:underline">Delete</button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private List<SiteResponse>? sites;
    private Guid ownerId;
    private Guid? pendingDelete;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        ownerId = UserClaims.UserIdOf((await AuthState).User)!.Value;
        sites = await _siteService.ListAsync(ownerId, default);
    }

    private async Task DeleteAsync(Guid siteId)
    {
        pendingDelete = null;

        // Already gone, or never yours — either way the reloaded list is the
        // answer, so only an unexpected outcome is worth saying.
        var result = await _siteService.DeleteAsync(siteId, ownerId, default);

        if (!result.IsOk && result.Kind is not ResultKind.NotFound)
            error = "Could not delete that site.";

        sites = await _siteService.ListAsync(ownerId, default);
    }
}
