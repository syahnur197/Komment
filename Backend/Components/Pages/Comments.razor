@page "/sites/{Id:guid}/comments"
@rendermode InteractiveServer
@attribute [Authorize]
@inject SiteService _siteService
@inject CommentService _commentService

<PageTitle>@Title</PageTitle>

<div class="flex items-center justify-between">
    <div>
        <a href="sites" class="text-sm text-sky-700 no-underline hover:underline">Sites</a>
        @if (SelectedPostSlug is not null)
        {
            <span class="mx-2 text-sm text-slate-400">/</span>
            <a href="sites/@Id/comments" class="text-sm text-sky-700 no-underline hover:underline">Post slugs</a>
        }
        <h1 class="text-2xl font-semibold text-slate-900">@(site?.Name ?? "Comments")</h1>
        @if (SelectedPostSlug is not null)
        {
            <p class="mt-3 font-mono text-sm text-slate-500">@SelectedPostSlug</p>
            @if (SelectedPostUrl is not null)
            {
                <a href="@SelectedPostUrl" target="_blank" rel="noopener noreferrer"
                   class="mt-1 inline-block text-sm text-sky-700 no-underline hover:underline">
                    Open blog
                </a>
            }
        }
    </div>
</div>

@if (error is not null)
{
    <p class="mt-4 rounded bg-red-50 px-3 py-2 text-sm text-red-700" role="alert">@error</p>
}

@if (notFound)
{
    <p class="mt-4 rounded bg-amber-50 px-3 py-2 text-sm text-amber-800" role="alert">That site does not exist.</p>
}
else if ((SelectedPostSlug is null && postSlugs is null) || (SelectedPostSlug is not null && comments is null))
{
    <p class="mt-4 text-slate-500">Loading…</p>
}
else if (SelectedPostSlug is null)
{
    @if (postSlugs!.Count == 0)
    {
        <div class="mt-6 rounded-lg border border-dashed border-slate-300 bg-white p-8 text-center">
            <p class="text-slate-600">No comments yet.</p>
            <p class="mt-1 text-sm text-slate-500">Comments arrive from the blog at <code class="font-mono">@site?.Slug</code>.</p>
        </div>
    }
    else
    {
        <ul class="mt-6 overflow-hidden rounded-lg border border-slate-200 bg-white">
            @foreach (var post in postSlugs)
            {
                <li class="border-b border-slate-100 last:border-0">
                    <a href="@PostSlugHref(post.Slug)"
                       class="flex items-center justify-between gap-4 px-4 py-3 no-underline hover:bg-slate-50">
                        <span class="min-w-0 font-mono text-sm text-slate-700">@post.Slug</span>
                        <span class="shrink-0 text-sm text-slate-500">
                            @post.CommentCount @(post.CommentCount == 1 ? "comment" : "comments")
                        </span>
                    </a>
                    @if (post.PostUrl is not null)
                    {
                        <a href="@post.PostUrl" target="_blank" rel="noopener noreferrer"
                           class="px-4 pb-3 text-sm text-sky-700 no-underline hover:underline">
                            Open blog
                        </a>
                    }
                </li>
            }
        </ul>
    }
}
else if (comments!.Count == 0)
{
    <div class="mt-6 rounded-lg border border-dashed border-slate-300 bg-white p-8 text-center">
        <p class="text-slate-600">No comments for this post.</p>
        <a href="sites/@Id/comments" class="mt-2 inline-block text-sm text-sky-700 hover:underline">Back to post slugs</a>
    </div>
}
else
{
    <ul class="mt-6 space-y-px overflow-hidden rounded-lg border border-slate-200 bg-white">
        @foreach (var comment in comments)
        {
            <li class="border-b border-slate-100 p-4 last:border-0 @(comment.ParentCommentId is null ? "" : "border-l-2 border-l-sky-200 pl-8")">
                <div class="flex items-baseline gap-2 text-sm">
                    <span class="font-medium text-slate-900">@comment.AuthorName</span>
                    @if (comment.ParentCommentId is not null)
                    {
                        <span class="text-slate-400">replied</span>
                    }
                    <time datetime="@comment.CreatedAt.ToString("o")" class="text-slate-400">
                        @comment.CreatedAt.ToLocalTime().ToString("d MMM yyyy HH:mm")
                    </time>
                    @if (comment.UpdatedAt > comment.CreatedAt)
                    {
                        <span class="text-slate-400">· edited</span>
                    }
                </div>

                <p class="mt-1 whitespace-pre-wrap text-slate-700">@comment.Body</p>

                <div class="mt-2 flex items-center gap-3 text-sm">
                    @if (pendingDelete == comment.CommentId)
                    {
                        <span class="text-slate-600">Delete this comment and its replies?</span>
                        <button type="button" @onclick="() => DeleteAsync(comment.CommentId)"
                                class="font-medium text-red-600 hover:underline">Delete</button>
                        <button type="button" @onclick="() => pendingDelete = null"
                                class="text-slate-500 hover:underline">Cancel</button>
                    }
                    else
                    {
                        <a href="sites/@Id/comments/@comment.CommentId?reply=true"
                           class="text-sky-700 no-underline hover:underline">Reply</a>

                        @* CommentService refuses edits from anyone but the author,
                           admin or not, so the link only appears where it works. *@
                        @if (comment.UserId == userId)
                        {
                            <a href="sites/@Id/comments/@comment.CommentId"
                               class="text-sky-700 no-underline hover:underline">Edit</a>
                        }

                        <button type="button" @onclick="() => pendingDelete = comment.CommentId"
                                class="text-red-600 hover:underline">Delete</button>
                    }
                </div>
            </li>
        }
    </ul>
}

@code {
    [Parameter] public Guid Id { get; set; }
    [SupplyParameterFromQuery] private string? PostSlug { get; set; }
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private SiteResponse? site;
    private List<PostSlugSummary>? postSlugs;
    private List<CommentResponse>? comments;
    private Guid userId;
    private Guid? pendingDelete;
    private bool notFound;
    private string? error;

    private string Title => site is null
        ? "Comments"
        : SelectedPostSlug is null ? $"Comments - {site.Name}" : $"{SelectedPostSlug} - {site.Name}";

    private string? SelectedPostSlug => string.IsNullOrWhiteSpace(PostSlug) ? null : PostSlug;
    private string? SelectedPostUrl => comments?.FirstOrDefault(c => c.PostUrl is not null)?.PostUrl;

    protected override async Task OnParametersSetAsync()
    {
        userId = UserClaims.UserIdOf((await AuthState).User)!.Value;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        // Owner-scoped, so this is both the authorisation check and the source of
        // the slug — comments are keyed by site slug, not by site id.
        var result = await _siteService.GetAsync(Id, userId, default);

        if (!result.IsOk)
        {
            notFound = true;
            return;
        }

        site = result.Value;
        pendingDelete = null;

        if (SelectedPostSlug is null)
        {
            comments = null;
            var allComments = await _commentService.ListAsync(site!.Slug, null, default);
            postSlugs = allComments
                .GroupBy(c => c.PostSlug)
                .Select(g => new PostSlugSummary(g.Key, g.FirstOrDefault(c => c.PostUrl is not null)?.PostUrl, g.Count()))
                .OrderBy(p => p.Slug)
                .ToList();
            return;
        }

        postSlugs = null;
        comments = await _commentService.ListAsync(site!.Slug, SelectedPostSlug, default);
    }

    private async Task DeleteAsync(Guid commentId)
    {
        pendingDelete = null;

        // Moderation: the service allows it for the author or the site's owner.
        var result = await _commentService.DeleteAsync(commentId, userId, isSiteAdmin: true, default);

        if (!result.IsOk && result.Kind is not ResultKind.NotFound)
            error = "Could not delete that comment.";

        await LoadAsync();
    }

    private string PostSlugHref(string postSlug) =>
        $"sites/{Id}/comments?postSlug={Uri.EscapeDataString(postSlug)}";

    private sealed record PostSlugSummary(string Slug, string? PostUrl, int CommentCount);
}
