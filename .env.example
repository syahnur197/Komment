# Google Cloud console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
# (type: Web application). Authorized redirect URI must be exactly:
#   https://localhost:7017/signin-google   (dev, port from launchSettings.json)
#   https://your-api-domain/signin-google  (prod)
#
# Blog origins are NOT here — they come from the Sites table, so registering a
# new blog is a POST /api/site, not a redeploy. (The admin console is the one
# exception; see DASHBOARD_ORIGIN below.)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Signs the Dashboard's bearer tokens. At least 32 bytes:
#   openssl rand -base64 48
# Required outside Development — the app refuses to start without it, because a
# default here would let anyone who read the source mint admin tokens. In
# Development a random key is generated per process, so tokens die on restart.
JWT_SIGNING_KEY=

# Origin(s) the admin console is served from, comma-separated. Blog origins come
# from the Sites table, but the console has no row there — it calls this API from
# the browser, so it needs a CORS entry of its own.
#   dev:  https://localhost:7222
#   prod: https://your-admin-domain
DASHBOARD_ORIGIN=https://localhost:7222

# true  -> SaaS mode: anyone may register as a site admin.
# false -> self-hosted: registration is open only until the first admin exists.
MULTI_TENANCY=false

# Postgres. Used by docker-compose; `dotnet run --project AppHost` ignores it and
# generates its own credentials for the container Aspire starts.
POSTGRES_PASSWORD=
