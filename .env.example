# Google Cloud console -> APIs & Services -> Credentials -> OAuth 2.0 Client ID
# (type: Web application). Authorized redirect URI must be exactly:
#   https://localhost:7017/signin-google   (dev, port from launchSettings.json)
#   https://your-api-domain/signin-google  (prod)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Every origin allowed to call /api/*, comma-separated. Scheme, host and port
# only — no trailing slash, no path. This is the CORS allowlist and the only
# place a login is allowed to redirect back to, so a typo here reads as "the
# widget does nothing". Read once at startup: changing it means a restart.
# The console needs no entry — it is served from this same origin.
ALLOWED_ORIGINS=https://blog.example.com,http://localhost:1313

# Requests per minute per caller, on /api/* only — keyed by user id when signed
# in, by IP otherwise. The console is a Blazor circuit, not requests, and is not
# counted. Counted in this process, so a restart forgives the current window.
RATE_LIMIT_PER_MINUTE=30

# Postgres. Used by docker-compose; `dotnet run --project AppHost` ignores it and
# generates its own credentials for the container Aspire starts.
POSTGRES_PASSWORD=
