@page "/sites"

<PageTitle>Sites</PageTitle>

<div data-page="sites">
    <div class="flex items-center justify-between">
        <h1 class="text-2xl font-semibold text-slate-900">Sites</h1>
        <a href="/sites/new" class="rounded bg-sky-700 px-4 py-2 text-sm font-medium text-white no-underline hover:bg-sky-800">
            Add site
        </a>
    </div>

    <p data-error hidden class="mt-4 rounded bg-red-50 px-3 py-2 text-sm text-red-700" role="alert"></p>
    <p data-status class="mt-4 text-slate-500">Loading…</p>

    @* Filled by Styles/js/pages/sites.js. Rows are built as DOM nodes, never as
       an HTML string — site names and origins are user input. *@
    <div data-list></div>
</div>
