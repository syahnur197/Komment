@page "/sites"

<PageTitle>Sites</PageTitle>

<div x-data="sites" x-cloak>
    <div class="flex items-center justify-between">
        <h1 class="text-2xl font-semibold text-slate-900">Sites</h1>
        <a href="/sites/new" class="rounded bg-sky-700 px-4 py-2 text-sm font-medium text-white no-underline hover:bg-sky-800">
            Add site
        </a>
    </div>

    <p x-show="error" x-text="error" role="alert"
       class="mt-4 rounded bg-red-50 px-3 py-2 text-sm text-red-700"></p>

    <p x-show="loading" class="mt-4 text-slate-500">Loading…</p>

    <div x-show="!loading && !sites.length"
         class="mt-6 rounded-lg border border-dashed border-slate-300 bg-white p-8 text-center">
        <p class="text-slate-600">No sites yet.</p>
        <p class="mt-1 text-sm text-slate-500">A site is one blog. Registering it also allows its origin through CORS.</p>
    </div>

    <div x-show="sites.length" class="mt-6 overflow-x-auto rounded-lg border border-slate-200 bg-white">
        <table class="w-full text-left text-sm">
            <thead class="border-b border-slate-200 text-slate-500">
                <tr>
                    <th class="px-4 py-3 font-medium">Name</th>
                    <th class="px-4 py-3 font-medium">Slug</th>
                    <th class="px-4 py-3 font-medium">Origins</th>
                    <th class="px-4 py-3"><span class="sr-only">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                @* x-text escapes — site names and origins are user input, and this
                   is why nothing here builds markup out of a string. *@
                <template x-for="site in sites" :key="site.siteId">
                    <tr class="border-b border-slate-100 last:border-0">
                        <td class="px-4 py-3 text-slate-900" x-text="site.name"></td>
                        <td class="px-4 py-3">
                            <code class="rounded bg-slate-100 px-1.5 py-0.5 font-mono text-slate-700" x-text="site.slug"></code>
                        </td>
                        <td class="px-4 py-3 text-slate-600">
                            <template x-for="origin in site.origins" :key="origin">
                                <div x-text="origin"></div>
                            </template>
                        </td>
                        <td class="px-4 py-3 text-right whitespace-nowrap">
                            <a :href="`/sites/${site.siteId}/comments`" class="text-sky-700 no-underline hover:underline">Comments</a>
                            <a :href="`/sites/${site.siteId}`" class="ml-3 text-sky-700 no-underline hover:underline">Edit</a>
                            <button type="button" x-on:click="remove(site)" class="ml-3 text-red-600 hover:underline">Delete</button>
                        </td>
                    </tr>
                </template>
            </tbody>
        </table>
    </div>
</div>

<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('sites', () => ({
            sites: [],
            error: '',
            loading: true,

            init() {
                if (!this.$store.auth.requireAdmin()) return;

                this.load();
            },

            async load() {
                this.error = '';

                try {
                    this.sites = await this.$api.get('/api/site', 'Could not load your sites.');
                } catch (failure) {
                    this.error = this.$api.message(failure, 'Could not load your sites.');
                } finally {
                    this.loading = false;
                }
            },

            async remove(site) {
                // ponytail: native confirm() is the guard. Deleting a site cascades
                // every comment on it, so promote this to a confirmation page if it
                // ever needs to survive JS being off.
                if (!confirm(`Delete ${site.name}? Every comment on it is deleted too.`)) return;

                this.error = '';

                try {
                    const response = await this.$api.delete(`/api/site/${site.siteId}`);

                    // Already gone, or never yours — either way the list is the answer.
                    if (!response.ok && response.status !== 404) {
                        this.error = 'Could not delete that site.';
                    }
                } catch (failure) {
                    this.error = this.$api.message(failure, 'Could not delete that site.');
                }

                await this.load();
            },
        }));
    });
</script>
