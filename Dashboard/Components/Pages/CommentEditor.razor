@page "/sites/{SiteId:guid}/comments/{Id:guid}"

<PageTitle>Edit comment</PageTitle>

@* One route, two jobs: ?reply=true switches this between editing and replying.
   The query string is read in the browser, so the shell renders the edit
   wording and the module rewrites it for a reply. *@
<div data-page="comment-editor" data-site-id="@SiteId" data-comment-id="@Id" class="max-w-2xl">
    <a href="/sites/@SiteId/comments" class="text-sm text-sky-700 no-underline hover:underline">Comments</a>
    <h1 data-title class="text-2xl font-semibold text-slate-900">Edit comment</h1>

    <p data-error hidden class="mt-4 rounded bg-red-50 px-3 py-2 text-sm text-red-700" role="alert"></p>

    <div data-blocked hidden class="mt-4 rounded bg-amber-50 px-3 py-2 text-sm text-amber-800" role="alert"></div>

    <p data-status class="mt-4 text-slate-500">Loading…</p>

    <div data-target hidden class="mt-4 rounded-lg border border-slate-200 bg-white p-4">
        <p data-target-slug class="font-mono text-xs text-slate-500"></p>
        <p data-target-author class="mt-1 text-sm font-medium text-slate-900"></p>
        <p data-target-body class="mt-1 whitespace-pre-wrap text-sm text-slate-600"></p>
    </div>

    <form data-comment-form hidden class="mt-4 space-y-4" novalidate>
        <div>
            <label data-body-label for="body" class="block text-sm font-medium text-slate-700">Comment</label>
            <textarea id="body" name="body" rows="6" required maxlength="4000"
                      class="mt-1 w-full rounded border border-slate-300 bg-white px-3 py-2 shadow-sm focus:border-sky-600 focus:ring-2 focus:ring-sky-600/20 focus:outline-none"></textarea>
        </div>

        <div class="flex items-center gap-3">
            <button type="submit" class="rounded bg-sky-700 px-4 py-2 font-medium text-white hover:bg-sky-800 disabled:opacity-60">
                Save changes
            </button>
            <a href="/sites/@SiteId/comments" class="text-sm text-sky-700 no-underline hover:underline">Cancel</a>
        </div>
    </form>
</div>

@code {
    [Parameter] public Guid SiteId { get; set; }
    [Parameter] public Guid Id { get; set; }
}
