@page "/sites/{Id:guid}/comments"

<PageTitle>Comments</PageTitle>

<div data-page="comments" data-site-id="@Id">
    <div class="flex items-center justify-between">
        <div>
            <a href="/sites" class="text-sm text-sky-700 no-underline hover:underline">Sites</a>
            @* Filled once the site fetch comes back — it is also the check that
               this site is yours, so there is nothing to show before it. *@
            <h1 data-site-name class="text-2xl font-semibold text-slate-900">Comments</h1>
        </div>
    </div>

    <p data-error hidden class="mt-4 rounded bg-red-50 px-3 py-2 text-sm text-red-700" role="alert"></p>
    <p data-not-found hidden class="mt-4 rounded bg-amber-50 px-3 py-2 text-sm text-amber-800" role="alert">That site does not exist.</p>
    <p data-status class="mt-4 text-slate-500">Loading…</p>

    <div data-list></div>
</div>

@code {
    [Parameter] public Guid Id { get; set; }
}
