@page "/sites/{Id:guid}/comments"

<PageTitle>Comments</PageTitle>

<div x-data="comments('@Id')" x-cloak>
    <div class="flex items-center justify-between">
        <div>
            <a href="/sites" class="text-sm text-sky-700 no-underline hover:underline">Sites</a>
            <h1 class="text-2xl font-semibold text-slate-900" x-text="site ? site.name : 'Comments'"></h1>
        </div>
    </div>

    <p x-show="error" x-text="error" role="alert"
       class="mt-4 rounded bg-red-50 px-3 py-2 text-sm text-red-700"></p>

    <p x-show="notFound" role="alert"
       class="mt-4 rounded bg-amber-50 px-3 py-2 text-sm text-amber-800">That site does not exist.</p>

    <p x-show="loading" class="mt-4 text-slate-500">Loading…</p>

    <div x-show="!loading && !notFound && !comments.length"
         class="mt-6 rounded-lg border border-dashed border-slate-300 bg-white p-8 text-center">
        <p class="text-slate-600">No comments yet.</p>
        <p class="mt-1 text-sm text-slate-500">
            Comments arrive from the blog at <code class="font-mono" x-text="site?.slug"></code>.
        </p>
    </div>

    @* Grouped by post because that is how a moderator reads them. The API returns
       one flat list ordered by time, so the grouping is a computed getter. *@
    <template x-for="group in grouped" :key="group.postSlug">
        <section class="mt-6">
            <h2 class="font-mono text-sm text-slate-500" x-text="group.postSlug"></h2>

            <ul class="mt-2 space-y-px overflow-hidden rounded-lg border border-slate-200 bg-white">
                <template x-for="comment in group.comments" :key="comment.commentId">
                    <li class="border-b border-slate-100 p-4 last:border-0"
                        :class="{ 'border-l-2 border-l-sky-200 pl-8': comment.parentCommentId }">
                        <div class="flex items-baseline gap-2 text-sm">
                            <span class="font-medium text-slate-900" x-text="comment.authorName"></span>
                            <span x-show="comment.parentCommentId" class="text-slate-400">replied</span>
                            <time :datetime="comment.createdAt" class="text-slate-400" x-text="when(comment.createdAt)"></time>
                            <span x-show="comment.updatedAt > comment.createdAt" class="text-slate-400">· edited</span>
                        </div>

                        <p class="mt-1 whitespace-pre-wrap text-slate-700" x-text="comment.body"></p>

                        <div class="mt-2 flex items-center gap-3 text-sm">
                            <a :href="`/sites/${id}/comments/${comment.commentId}?reply=true`"
                               class="text-sky-700 no-underline hover:underline">Reply</a>

                            @* The API refuses edits from anyone but the author, admin
                               or not, so the link only appears where it would work. *@
                            <a x-show="comment.userId === $store.auth.userId"
                               :href="`/sites/${id}/comments/${comment.commentId}`"
                               class="text-sky-700 no-underline hover:underline">Edit</a>

                            <button type="button" x-on:click="remove(comment)" class="text-red-600 hover:underline">Delete</button>
                        </div>
                    </li>
                </template>
            </ul>
        </section>
    </template>
</div>

<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('comments', (id) => ({
            id,
            site: null,
            comments: [],
            error: '',
            notFound: false,
            loading: true,

            get grouped() {
                const groups = new Map();

                for (const comment of this.comments) {
                    if (!groups.has(comment.postSlug)) groups.set(comment.postSlug, []);
                    groups.get(comment.postSlug).push(comment);
                }

                return [...groups.entries()]
                    .sort(([a], [b]) => a.localeCompare(b))
                    .map(([postSlug, comments]) => ({ postSlug, comments }));
            },

            init() {
                if (!this.$store.auth.requireAdmin()) return;

                this.load();
            },

            async load() {
                this.error = '';

                try {
                    // Owner-scoped at the API, so this fetch is both the
                    // authorisation check and where the slug comes from — comment
                    // endpoints key off site=<slug>, and a comment response carries
                    // no site of its own.
                    this.site = await this.$api.get(`/api/site/${this.id}`, 'Could not load that site.');
                    document.title = `Comments — ${this.site.name}`;
                } catch (failure) {
                    if (this.$api.offline(failure)) this.error = failure.message;
                    else this.notFound = true;

                    this.loading = false;
                    return;
                }

                try {
                    const query = encodeURIComponent(this.site.slug);
                    this.comments = await this.$api.get(`/api/comment?site=${query}`, 'Could not load comments.');
                } catch (failure) {
                    this.error = this.$api.message(failure, 'Could not load comments.');
                } finally {
                    this.loading = false;
                }
            },

            async remove(comment) {
                if (!confirm('Delete this comment? Its replies are deleted too.')) return;

                this.error = '';

                try {
                    const response = await this.$api.delete(`/api/comment/${comment.commentId}`);

                    // Already gone is the outcome we wanted anyway.
                    if (!response.ok && response.status !== 404) {
                        this.error = 'Could not delete that comment.';
                    }
                } catch (failure) {
                    this.error = this.$api.message(failure, 'Could not delete that comment.');
                }

                await this.load();
            },

            when: (iso) => new Date(iso).toLocaleString(undefined, {
                day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit',
            }),
        }));
    });
</script>
