@page "/"

<PageTitle>Dashboard</PageTitle>

<h1 class="text-2xl font-semibold text-slate-900">Dashboard</h1>

<AuthorizeView>
    <Authorized>
        <p class="mt-2 text-slate-600">Signed in as @context.User.Identity!.Name.</p>
    </Authorized>
    <NotAuthorized>
        <p class="mt-2 text-slate-600"><a href="login" class="text-sky-700 hover:underline">Sign in</a> to manage your sites.</p>
    </NotAuthorized>
</AuthorizeView>
