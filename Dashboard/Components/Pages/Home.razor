@page "/"

<PageTitle>Dashboard</PageTitle>

<h1 class="text-2xl font-semibold text-slate-900">Dashboard</h1>

<AuthorizeView>
    <Authorized>
        <p class="mt-2 text-slate-600">Signed in as @context.User.Identity!.Name.</p>
        <a href="sites" class="mt-4 inline-block rounded bg-sky-700 px-4 py-2 text-sm font-medium text-white no-underline hover:bg-sky-800">Manage sites</a>
    </Authorized>
    <NotAuthorized>
        <p class="mt-2 text-slate-600"><a href="login" class="text-sky-700 hover:underline">Sign in</a> to manage your sites.</p>
    </NotAuthorized>
</AuthorizeView>
