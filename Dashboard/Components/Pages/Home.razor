@page "/"

<PageTitle>Dashboard</PageTitle>

@* x-data with no component: the store is all this page needs. init() still runs,
   which is where the sign-in guard lives. *@
<div x-data x-cloak x-init="$store.auth.requireAdmin()">
    <h1 class="text-2xl font-semibold text-slate-900">Dashboard</h1>

    <div x-show="$store.auth.signedIn">
        <p class="mt-2 text-slate-600">Signed in as <span x-text="$store.auth.name"></span>.</p>
        <a href="/sites" class="mt-4 inline-block rounded bg-sky-700 px-4 py-2 text-sm font-medium text-white no-underline hover:bg-sky-800">Manage sites</a>
    </div>
</div>
